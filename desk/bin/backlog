#!/usr/bin/env python3
"""Add, list, adopt, move, fill in, place and change items, ask questions, note findings and keep goals."""

from __future__ import annotations

import argparse
import datetime
import json
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

DESK = Path.home() / "desk"
BACKLOG = DESK / "backlog"
EFFORTS = DESK / "efforts"
SHARED_FINDINGS = DESK / "findings.md"
KINDS = ["bugfix", "feature", "review", "design", "test", "docs"]
LABELS = ["user-visible bug", "reachable but rare", "theoretical"]
BOARD = "http://127.0.0.1:8765"
BRIEF_SECTIONS = ["Goal", "Done when", "Plan"]
FIELD_LIMITS = {"title": 70, "why": 140, "seen": 140, "from_me": 80, "start": 240}
ASK_KINDS = ["decide", "review", "push", "post", "device-test"]

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "board"))
from server import (  # noqa: E402
    FATES,
    GOALS,
    MILESTONE,
    PLACES,
    add_item,
    all_items,
    apply_status,
    free_path,
    log_event,
    parked,
    place_today,
    repos,
    require_desk_home,
    slug_id,
    write_json,
)


def create(args: argparse.Namespace, brief: str, **extra: object) -> dict:
    fields = {"repo": args.repo, "effort": args.effort, "kind": args.kind, "label": args.label, "summary": args.summary}
    return add_item(args.title, **fields, brief=brief, source=args.source, **extra)


def size_and_minutes(value: str) -> tuple[str, int]:
    match = re.fullmatch(r"([SML])\s*:\s*(\d+)", value.strip(), re.I)
    if not match:
        raise argparse.ArgumentTypeError("use S, M or L and my minutes, like S:10")
    return match[1].upper(), int(match[2])


def ensure_effort(slug: str | None) -> Path | None:
    """Create a new effort's folder with a status.md skeleton and return it, or None when the folder exists."""
    if not slug or (EFFORTS / slug).exists():
        return None
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
        sys.exit(f"effort {slug!r} is not a short lowercase slug")
    folder = EFFORTS / slug
    folder.mkdir(parents=True)
    sections = ["Resume here", "Tasks", "Defaults", "Open decisions", "Log"]
    (folder / "status.md").write_text(f"# {slug}\n\n" + "".join(f"## {s}\n\n" for s in sections))
    return folder


def drop_effort(folder: Path | None) -> None:
    if folder:
        (folder / "status.md").unlink()
        folder.rmdir()


def post(path: str, body: dict) -> None:
    request = urllib.request.Request(
        f"{BOARD}/api/{path}", data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}
    )
    urllib.request.urlopen(request, timeout=10)


def add(args: argparse.Namespace) -> None:
    if args.label == "theoretical":
        sys.exit("theoretical findings don't go on the backlog, note it with `bin/backlog finding` instead")
    for name, limit in FIELD_LIMITS.items():
        value = " ".join(getattr(args, name).split())
        if len(value) > limit:
            sys.exit(f"--{name.replace('_', '-')} has {len(value)} characters, keep it to {limit}")
        setattr(args, name, value)
    brief = sys.stdin.read().strip() if args.brief == "-" else args.brief
    if not re.search(r"^##\s+Drop if\b", brief, re.M | re.I):
        sys.exit("the brief needs a Drop if section, see Backlog items in ~/desk/AGENTS.md")
    missing = [s for s in BRIEF_SECTIONS if not re.search(rf"^##\s+{s}\b", brief, re.M | re.I)]
    if missing:
        print(f"warning: the brief has no {', '.join(missing)} section, see Backlog items in ~/desk/AGENTS.md", file=sys.stderr)
    if args.parent:
        check_parent(args.parent)
    fields = {"seen": args.seen, "why": args.why, "size": args.size[0], "minutes": args.size[1], "fromMe": args.from_me}
    item = create(args, brief, **fields, start=args.start, **({"parent": args.parent} if args.parent else {}))
    print(BACKLOG / f"{item['id']}.json")


def finding(args: argparse.Namespace) -> None:
    if args.effort and not (EFFORTS / args.effort / "status.md").exists():
        sys.exit(f"no effort {args.effort}")
    path = EFFORTS / args.effort / "findings.md" if args.effort else SHARED_FINDINGS
    text = " ".join(args.text.split())
    with path.open("a") as f:
        f.write(f"- {datetime.date.today().isoformat()} {args.repo}: {text} (from {args.source})\n")
    print(path)


def move(args: argparse.Namespace) -> None:
    session = {"session": args.session, "checkout": args.checkout, "branch": args.branch, "manager": args.manager}
    if not args.manager and not args.checkout:
        sys.exit("--checkout is required without --manager")
    args.source = args.session
    brief = Path(args.brief_file).read_text().strip()
    new_effort = ensure_effort(args.effort)
    prs = args.pr or []
    item = create(args, brief, pr=prs[0] if prs else None, prs=prs, move=session)
    try:
        post("status", {"ids": [item["id"]], "status": "requested"})
    except OSError as err:
        (BACKLOG / f"{item['id']}.json").unlink()
        drop_effort(new_effort)
        sys.exit(f"the board did not take the Start, no item added: {err}")
    print(item["id"])


def adopt(args: argparse.Namespace) -> None:
    items = [json.loads(path.read_text()) for path in BACKLOG.glob("*.json")]
    item = next((i for i in items if i["thread"] == args.thread and i["status"] not in ("done", "dropped")), None)
    new = item is None
    brief = Path(args.brief_file).read_text().strip()
    new_effort = ensure_effort(args.effort)
    if new:
        args.source = args.thread
        item = create(args, brief, status="started", thread=args.thread, pr=args.pr)
    elif item.get("adopted") == "auto":
        fields = {
            "title": args.title,
            "repo": args.repo,
            "summary": args.summary,
            "brief": brief,
            "kind": args.kind,
            "pr": args.pr,
        }
        item.update({key: value for key, value in fields.items() if value})
        write_json(BACKLOG / f"{item['id']}.json", item)
    status = "open" if args.blocked_by else args.status
    try:
        if new or item.get("adopted"):
            post("adopt", {"id": item["id"]})
        if not new and args.effort:
            post("update", {"ids": [item["id"]], "fields": {"effort": args.effort}})
        if args.blocked_by:
            blockers = (item.get("blockedBy") or []) + [b for b in args.blocked_by if b not in (item.get("blockedBy") or [])]
            post("update", {"ids": [item["id"]], "fields": {"blockedBy": blockers}})
        if status == "dropped":
            post("status", {"ids": [item["id"]], "status": "open"})
        if status:
            post("status", {"ids": [item["id"]], "status": status})
        if args.note:
            post("comment", {"id": item["id"], "text": args.note})
    except OSError as err:
        if new:
            (BACKLOG / f"{item['id']}.json").unlink()
        drop_effort(new_effort)
        sys.exit(f"the board did not take the change, {'no item added' if new else 'the item may be half changed'}: {err}")
    print(item["id"])


def ask(args: argparse.Namespace) -> None:
    try:
        post(
            "ask",
            {"thread": args.thread, "text": None if args.clear else args.question, "kind": args.kind, "minutes": args.minutes},
        )
    except urllib.error.HTTPError as err:
        sys.exit(json.loads(err.read() or b"{}").get("error", str(err)))
    except OSError as err:
        sys.exit(f"the board did not take the question: {err}")


def set_status(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    old = item["status"]
    if args.thread:
        item["thread"] = args.thread
    if args.pr:
        item["pr"] = args.pr
    if args.status == "started" and not item["thread"]:
        sys.exit("a started item needs --thread")
    if old != args.status:
        apply_status(item, args.status)
    write_json(path, item)
    if old == args.status:
        return
    log_event({"type": "status", "changes": [{"id": args.id, "from": old, "to": args.status}], "by": args.by})


def comment(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    item["comments"].append({"at": datetime.datetime.now().isoformat(timespec="seconds"), "by": args.by, "text": args.text})
    write_json(path, item)
    log_event({"type": "comment", "id": args.id, "by": args.by})


def unblock(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    if args.blocker not in (item.get("blockedBy") or []):
        sys.exit(f"{args.id} has no blocker {args.blocker!r}")
    item["blockedBy"] = [b for b in item["blockedBy"] if b != args.blocker]
    if not item["blockedBy"]:
        item["unblocked"] = datetime.datetime.now().isoformat(timespec="seconds")
    write_json(path, item)


def link_issue(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    item["issue"] = args.url or None
    write_json(path, item)


def reslug(args: argparse.Namespace) -> None:
    old_path = BACKLOG / f"{args.id}.json"
    if not old_path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(old_path.read_text())
    base = slug_id(datetime.date.fromisoformat(item["created"]), item["title"])
    if re.fullmatch(re.escape(base) + r"(-\d+)?", args.id):
        print(args.id)
        return
    new_path = free_path(base)
    new_id = new_path.stem
    pattern = re.compile(r"(?<![a-z0-9-])" + re.escape(args.id) + r"(?![a-z0-9-])")

    def renamed(value: object) -> object:
        if isinstance(value, str):
            return pattern.sub(new_id, value)
        if isinstance(value, list):
            return [renamed(v) for v in value]
        if isinstance(value, dict):
            return {k: renamed(v) for k, v in value.items()}
        return value

    write_json(new_path, renamed(item))
    old_path.unlink()
    for path in sorted(BACKLOG.glob("*.json")):
        other = json.loads(path.read_text())
        updated = renamed(other)
        if updated != other:
            write_json(path, updated)
            print(f"updated {path.stem}")
    for path in sorted(EFFORTS.rglob("*")):
        notes = path.is_file() and path.suffix in (".md", ".json") and not {"evidence", "work"} & set(path.parts)
        if notes and args.id in path.read_text(errors="replace"):
            print(f"still names the old id: {path}")
    if item["thread"] and item["status"] not in ("done", "dropped"):
        print(f"thread {item['thread']} may still read backlog/{args.id}.json")
    print(new_id)


def wait_moved(args: argparse.Namespace) -> None:
    start = time.monotonic()
    while True:
        items = [json.loads((BACKLOG / f"{i}.json").read_text()) for i in args.ids]
        started = [i for i in items if i["thread"] and i["status"] != "requested"]
        stuck = [i for i in items if i not in started and i.get("needs")]
        held = [i for i in items if not i["thread"] and i["status"] != "requested"]
        timed_out = time.monotonic() - start >= args.max
        if len(started) + len(stuck) + len(held) == len(items) or timed_out:
            for item in started:
                print(f"{item['move']['session']} {item['thread']}")
            for item in stuck:
                print(f"stuck {item['id']} {item['move']['session']}: {item['needs']}")
            for item in held:
                print(f"held {item['id']} {item['move']['session']}: {item['status']}")
            if timed_out:
                print("timeout " + " ".join(i["id"] for i in items if i not in started + stuck + held))
            return
        time.sleep(10)


def load_goal(slug: str) -> dict:
    path = GOALS / f"{slug}.json"
    if not path.exists():
        sys.exit(f"no goal {slug}, see `bin/backlog goal list`")
    return json.loads(path.read_text())


def check_parent(parent: str) -> None:
    match = MILESTONE.fullmatch(parent)
    if match and not 1 <= int(match[2]) <= len(load_goal(match[1])["milestones"]):
        sys.exit(f"goal {match[1]} has no milestone {match[2]}")


def goal_new(args: argparse.Namespace) -> None:
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args.slug):
        sys.exit(f"goal {args.slug!r} is not a short lowercase slug")
    path = GOALS / f"{args.slug}.json"
    if path.exists():
        sys.exit(f"goal {args.slug} exists, change it with `bin/backlog goal set`")
    if args.effort and not (EFFORTS / args.effort).exists():
        sys.exit(f"no effort {args.effort}")
    GOALS.mkdir(parents=True, exist_ok=True)
    goal = {"slug": args.slug, "title": args.title, "effort": args.effort, "outcome": args.outcome, "outOfScope": [], "cut": None}
    write_json(path, {**goal, "created": datetime.date.today().isoformat(), "milestones": []})
    print(path)


def goal_set(args: argparse.Namespace) -> None:
    goal = load_goal(args.slug)
    for field in ("title", "outcome"):
        if getattr(args, field):
            goal[field] = getattr(args, field)
    goal["outOfScope"] += args.out or []
    for text in args.back or []:
        if text not in goal["outOfScope"]:
            sys.exit(f"{text!r} is not out of scope, it lists: {goal['outOfScope']}")
        goal["outOfScope"].remove(text)
    if args.cut is not None:
        if not 0 <= args.cut <= len(goal["milestones"]):
            sys.exit(f"goal {args.slug} has {len(goal['milestones'])} milestones")
        goal["cut"] = args.cut or None
    write_json(GOALS / f"{args.slug}.json", goal)


def goal_milestone(args: argparse.Namespace) -> None:
    goal = load_goal(args.slug)
    milestones = goal["milestones"]
    if args.number is None:
        if not args.title or not args.try_on:
            sys.exit("a new milestone needs --title and --try")
        milestones.append({"title": args.title, "try": args.try_on, "research": []})
        number = len(milestones)
    else:
        number = args.number
        if not 1 <= number <= len(milestones):
            sys.exit(f"goal {args.slug} has no milestone {number}")
    milestone = milestones[number - 1]
    milestone.update({k: v for k, v in (("title", args.title), ("try", args.try_on)) if v})
    milestone["research"] = [r for r in milestone["research"] + (args.research or []) if r not in (args.settled or [])]
    write_json(GOALS / f"{args.slug}.json", goal)
    print(f"{args.slug}#{number}")


def goal_attach(args: argparse.Namespace) -> None:
    if args.milestone and not MILESTONE.fullmatch(args.milestone):
        sys.exit("name the milestone as <goal slug>#<number>")
    check_parent(args.milestone)
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    if args.milestone:
        item["parent"] = args.milestone
    else:
        item.pop("parent", None)
    write_json(path, item)


def goal_list(args: argparse.Namespace) -> None:
    for path in sorted(GOALS.glob("*.json")) if GOALS.exists() else []:
        goal = json.loads(path.read_text())
        milestones = "".join(f"\n  #{n} {m['title']}" for n, m in enumerate(goal["milestones"], 1))
        print(f"{goal['slug']}  {goal.get('effort') or 'no effort'}: {goal['title']}{milestones}")


def fate(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    item["fate"] = {"pick": args.pick, "why": " ".join(args.why.split()), "at": datetime.date.today().isoformat()}
    write_json(path, item)


def fill(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    for name, field in (("why", "why"), ("from_me", "fromMe"), ("start", "start")):
        value = " ".join((getattr(args, name) or "").split())
        if len(value) > FIELD_LIMITS[name]:
            sys.exit(f"--{name.replace('_', '-')} has {len(value)} characters, keep it to {FIELD_LIMITS[name]}")
        if value:
            item[field] = value
    if args.size:
        item["size"], item["minutes"] = args.size
    if args.needs:
        if item["status"] != "requested":
            sys.exit("--needs is for an item I pressed Start on that could not start")
        item["needs"] = " ".join(args.needs.split())
    write_json(path, item)


def urgent(args: argparse.Namespace) -> None:
    path = BACKLOG / f"{args.id}.json"
    if not path.exists():
        sys.exit(f"no item {args.id}")
    item = json.loads(path.read_text())
    if args.clear:
        item.pop("urgent", None)
    else:
        item["urgent"] = True
    write_json(path, item)


def place(args: argparse.Namespace) -> None:
    try:
        place_today(args.id, None if args.to == "plan" else args.to)
    except FileNotFoundError:
        sys.exit(f"no item {args.id}")


def list_items(args: argparse.Namespace) -> None:
    items = all_items()
    for item in items.values():
        if args.parked and not parked(item, items):
            continue
        if args.all or item["status"] in ("new", "open", "requested", "started"):
            if args.repo and item["repo"] != args.repo:
                continue
            print(f"{item['id']}  [{item['status']}] {item['repo']}: {item['title']}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    known_repos = repos()
    sub = parser.add_subparsers(dest="command", required=True)

    p_add = sub.add_parser("add", help="add an open item and print its path")
    p_add.add_argument("--title", required=True, help="the outcome someone notices, verb first")
    p_add.add_argument("--repo", required=True, choices=known_repos, metavar="REPO", help="repo name: " + ", ".join(known_repos))
    p_add.add_argument("--kind", required=True, choices=KINDS)
    p_add.add_argument("--label", required=True, choices=LABELS)
    p_add.add_argument("--why", required=True, help="one line: who notices what, and how often")
    p_add.add_argument("--size", required=True, type=size_and_minutes, help="S, M or L and my minutes for it, like S:10")
    p_add.add_argument(
        "--from-me", required=True, help="what it needs from me: nothing until review, a decision on X, a device test, a push OK"
    )
    p_add.add_argument("--start", required=True, help="the first concrete step, which goes into the launch message")
    p_add.add_argument("--summary", default="", help="one or two sentences")
    p_add.add_argument("--brief", required=True, help="evidence and plan, or - to read stdin")
    p_add.add_argument("--parent", help="the item id or goal milestone this item is part of")
    p_add.add_argument(
        "--seen", required=True, help="who or what saw the problem or asked for the work, like a failing test or a user report"
    )
    p_add.add_argument("--effort", default=None)
    p_add.add_argument("--source", default="unknown", help="thread or session id")
    p_add.set_defaults(func=add)

    p_finding = sub.add_parser("finding", help="note a finding nobody saw in its effort's findings list, not on the backlog")
    p_finding.add_argument(
        "--repo", required=True, choices=known_repos, metavar="REPO", help="repo name: " + ", ".join(known_repos)
    )
    p_finding.add_argument("text", help="the finding in one line")
    p_finding.add_argument("--source", required=True, help="the thread or session that found it")
    p_finding.add_argument("--effort", default=None, help="the effort it belongs to, or none for the shared list")
    p_finding.set_defaults(func=finding)

    p_adopt = sub.add_parser("adopt", help="add a started item for a running T3 thread, or reuse its item")
    p_adopt.add_argument("--title", required=True)
    p_adopt.add_argument(
        "--repo", required=True, choices=known_repos, metavar="REPO", help="repo name: " + ", ".join(known_repos)
    )
    p_adopt.add_argument("--kind", choices=KINDS)
    p_adopt.add_argument("--summary", required=True, help="one or two sentences")
    p_adopt.add_argument("--brief-file", required=True, help="the brief the thread wrote")
    p_adopt.add_argument("--thread", required=True, help="the T3 thread id")
    p_adopt.add_argument("--pr", help="the PR URL")
    p_adopt.add_argument("--blocked-by", action="append", help="pause the item until this happens, repeatable")
    p_adopt.add_argument("--status", choices=["open", "done", "dropped"], help="pause (open), finish or drop the item")
    p_adopt.add_argument("--note", help="my words for the desk, added to the item as my comment")
    p_adopt.add_argument("--effort", default=None, help="an effort slug, created when it's new")
    p_adopt.set_defaults(func=adopt, label=None)

    p_move = sub.add_parser("move", help="add an item for a Claude desktop session and press Start for it")
    p_move.add_argument("--title", required=True)
    p_move.add_argument("--repo", required=True, choices=known_repos, metavar="REPO", help="repo name: " + ", ".join(known_repos))
    p_move.add_argument("--kind", choices=KINDS)
    p_move.add_argument("--summary", required=True, help="one or two sentences")
    p_move.add_argument("--brief-file", required=True, help="the brief the session wrote")
    p_move.add_argument("--session", required=True, help="the desktop session id, local_...")
    p_move.add_argument("--checkout", help="the repo's main checkout, not needed with --manager")
    p_move.add_argument("--branch", help="the branch to continue on")
    p_move.add_argument("--pr", action="append", help="a PR URL, repeatable, the main PR first")
    p_move.add_argument("--manager", action="store_true", help="the session is the effort's coordinator")
    p_move.add_argument("--effort", default=None, help="an effort slug, created when it's new")
    p_move.set_defaults(func=move, label=None)

    p_ask = sub.add_parser("ask", help="show a question on the board under the thread's item, or clear it")
    p_ask.add_argument("--thread", required=True, help="the T3 thread id")
    p_ask_text = p_ask.add_mutually_exclusive_group(required=True)
    p_ask_text.add_argument("question", nargs="?", help="the question in one line")
    p_ask_text.add_argument("--clear", action="store_true", help="remove the question once I answered")
    p_ask.add_argument("--kind", choices=ASK_KINDS, help="what answering takes from me")
    p_ask.add_argument("--minutes", type=int, help="my minutes for it, when you can estimate them better than the kind")
    p_ask.set_defaults(func=ask)

    p_status = sub.add_parser("status", help="set an item's status and log it for the desk like a board change")
    p_status.add_argument("id")
    p_status.add_argument("status", choices=["open", "started", "done", "dropped"])
    p_status.add_argument("--thread", help="the T3 thread id, required to start an item without one")
    p_status.add_argument("--pr", help="the PR URL")
    p_status.add_argument(
        "--by", required=True, choices=["desk", "manager"], help="who makes the change, so the desk is not woken for its own"
    )
    p_status.set_defaults(func=set_status)

    p_comment = sub.add_parser("comment", help="add a comment to an item, which reaches its effort's manager")
    p_comment.add_argument("id")
    p_comment.add_argument("text")
    p_comment.add_argument("--by", required=True, choices=["task", "manager", "desk"], help="who writes it")
    p_comment.set_defaults(func=comment)

    p_unblock = sub.add_parser("unblock", help="remove one blocker from an item")
    p_unblock.add_argument("id")
    p_unblock.add_argument("blocker", help="the blocker exactly as the item lists it")
    p_unblock.set_defaults(func=unblock)

    p_issue = sub.add_parser("issue", help="link an item to its GitHub issue, or unlink it with an empty url")
    p_issue.add_argument("id")
    p_issue.add_argument("url")
    p_issue.set_defaults(func=link_issue)

    p_reslug = sub.add_parser("reslug", help="rename an item's id and file after its title and update references to it")
    p_reslug.add_argument("id")
    p_reslug.set_defaults(func=reslug)

    p_wait = sub.add_parser("wait-moved", help="wait until each item started, needs me, or I took it back before it started")
    p_wait.add_argument("ids", nargs="+")
    p_wait.add_argument("--max", type=int, default=6600, help="give up after this many seconds")
    p_wait.set_defaults(func=wait_moved)

    p_list = sub.add_parser("list", help="list items that are not done or dropped")
    p_list.add_argument("--repo")
    p_list.add_argument("--all", action="store_true", help="include done and dropped")
    p_list.add_argument("--parked", action="store_true", help="only parked items, see Backlog items in ~/desk/AGENTS.md")
    p_list.set_defaults(func=list_items)

    p_fill = sub.add_parser("fill", help="fill in the size, why, from-me, start or needs of an existing item")
    p_fill.add_argument("id")
    p_fill.add_argument("--size", type=size_and_minutes, help="S, M or L and my minutes for it, like S:10")
    p_fill.add_argument("--why", help="one line: who notices what, and how often")
    p_fill.add_argument("--from-me", help="what it needs from me")
    p_fill.add_argument("--start", help="the first concrete step")
    p_fill.add_argument("--needs", help="why a requested item could not start, shown on the board with Start again")
    p_fill.set_defaults(func=fill)

    p_urgent = sub.add_parser("urgent", help="keep an item above my Today line whatever its minutes, or stop that")
    p_urgent.add_argument("id")
    p_urgent.add_argument("--clear", action="store_true")
    p_urgent.set_defaults(func=urgent)

    p_place = sub.add_parser("place", help="move an item above or below my Today line, or back to where the plan puts it")
    p_place.add_argument("id")
    p_place.add_argument("to", choices=[*PLACES, "plan"])
    p_place.set_defaults(func=place)

    p_fate = sub.add_parser("fate", help="suggest what becomes of a parked item, shown on the board for me to settle")
    p_fate.add_argument("id")
    p_fate.add_argument("pick", choices=FATES)
    p_fate.add_argument("why", help="one line")
    p_fate.set_defaults(func=fate)

    p_goal = sub.add_parser("goal", help="create or change a goal above items, see Goals in ~/desk/AGENTS.md")
    goals = p_goal.add_subparsers(dest="action", required=True)
    g_new = goals.add_parser("new", help="create a goal and print its path")
    g_new.add_argument("slug")
    g_new.add_argument("--title", required=True)
    g_new.add_argument("--outcome", required=True, help="what I can check once the goal is reached")
    g_new.add_argument("--effort", default=None)
    g_new.set_defaults(func=goal_new)
    g_set = goals.add_parser("set", help="change a goal's title, outcome, scope or cut line")
    g_set.add_argument("slug")
    g_set.add_argument("--title")
    g_set.add_argument("--outcome")
    g_set.add_argument("--out", action="append", help="add a line to what's out of scope, repeatable")
    g_set.add_argument("--back", action="append", help="remove a line from what's out of scope, repeatable")
    g_set.add_argument("--cut", type=int, help="the last milestone that ships first, 0 for no cut line")
    g_set.set_defaults(func=goal_set)
    g_milestone = goals.add_parser("milestone", help="add a milestone, or change one by its number, and print it")
    g_milestone.add_argument("slug")
    g_milestone.add_argument("number", nargs="?", type=int)
    g_milestone.add_argument("--title")
    g_milestone.add_argument("--try", dest="try_on", help="what I try on a real device once it's done")
    g_milestone.add_argument("--research", action="append", help="add an open research question, repeatable")
    g_milestone.add_argument("--settled", action="append", help="remove a research question, repeatable")
    g_milestone.set_defaults(func=goal_milestone)
    g_attach = goals.add_parser("attach", help="make an item part of a milestone, or detach it with an empty milestone")
    g_attach.add_argument("id")
    g_attach.add_argument("milestone", help="<goal slug>#<milestone number>")
    g_attach.set_defaults(func=goal_attach)
    g_list = goals.add_parser("list", help="list goals and their milestones")
    g_list.set_defaults(func=goal_list)

    args = parser.parse_args()
    if args.func not in (list_items, goal_list):
        require_desk_home()
    args.func(args)


if __name__ == "__main__":
    main()
