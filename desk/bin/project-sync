#!/usr/bin/env python3
"""Propose changes to the GitHub project boards and backlog issues in ~/desk/watch.json, and apply the ones I approved."""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

DESK = Path.home() / "desk"
CONFIG = DESK / "watch.json"
BACKLOG = DESK / "backlog"
EFFORTS = DESK / "efforts"
PROPOSALS = DESK / "state" / "proposals.json"
EARLY = {"triage", "later", "next"}
STALE_DAYS = 14
OUTDATED_DAYS = 3
ISSUE_URL = r"https://github\.com/[^/\s]+/[^/\s]+/issues/\d+"
REFERENCE = re.compile(
    r"https://github\.com/([\w.-]+)/([\w.-]+)/(?:issues|pull)/(\d+)|\b([\w.-]+)/([\w.-]+)#(\d+)|(?<![\w/])#(\d+)"
)
BODY_CHARS = 600

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "board"))
from server import locked, require_desk_home, write_json  # noqa: E402


def gh_text(*args: str) -> str:
    result = subprocess.run(["gh", *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"gh exit {result.returncode}")
    return result.stdout


def gh(*args: str) -> object:
    return json.loads(gh_text(*args) or "null")


def boards() -> list[str]:
    config = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    return [f"{b['owner']}/{b['number']}" for b in config.get("projects", [])]


def fields(board: str) -> dict[str, dict]:
    owner, number = board.split("/")
    return {f["name"].lower(): f for f in gh("project", "field-list", number, "--owner", owner, "--format", "json")["fields"]}


def option(field: dict, name: str) -> dict:
    found = next((o for o in field.get("options", []) if o["name"].lower() == name.lower()), None)
    if found is None:
        raise ValueError(f"{field['name']} has no option {name}")
    return found


def proposal(board: str, action: str, url: str | None, title: str, to: str | None, why: str, **extra: object) -> dict:
    body = f" {extra['body']}" if extra.get("body") else ""
    key = hashlib.sha1(f"{board} {action} {url or title} {to}{body}".encode()).hexdigest()[:10]
    return {
        "id": key,
        "board": board,
        "action": action,
        "url": url,
        "title": title,
        "to": to,
        "why": why,
        "state": "open",
        "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        **extra,
    }


def content_state(url: str, cache: dict) -> dict:
    if url not in cache:
        owner, repo, number = re.match(r"https://github\.com/([^/]+)/([^/]+)/(?:issues|pull)/(\d+)", url).groups()
        cache[url] = gh("api", f"repos/{owner}/{repo}/issues/{number}")
    return cache[url]


def issue_context(issue: dict) -> dict:
    body = (issue.get("body") or "").strip()
    return {
        "state": issue["state"],
        "updated": issue["updated_at"],
        "comments": issue["comments"],
        "assignees": [a["login"] for a in issue.get("assignees") or []],
        "labels": [label["name"] for label in issue.get("labels") or []],
        "text": body[:BODY_CHARS] + ("…" if len(body) > BODY_CHARS else ""),
    }


def html_url(api_url: str) -> str:
    return api_url.replace("https://api.github.com/repos/", "https://github.com/")


def efforts() -> dict[str, dict]:
    """Map each effort to the repos its Scope names on a board's account, that board, and its parent issue."""
    owners = {b.split("/")[0]: b for b in boards()}
    found = {}
    for status in sorted(EFFORTS.glob("*/status.md")):
        lines = status.read_text().splitlines()
        scope = next((line for line in lines if line.startswith("Scope:")), "")
        issue = next((re.search(ISSUE_URL, line) for line in lines if line.startswith("Issue:")), None)
        repos = [r.rstrip(".") for r in re.findall(r"\b[\w.-]+/[\w.-]+", scope) if r.split("/")[0] in owners]
        board = owners[repos[0].split("/")[0]] if repos else None
        found[status.parent.name] = {"repos": repos, "board": board, "issue": issue.group(0) if issue else None}
    return found


def closing_issue(item: dict) -> str | None:
    for pr in item.get("prs") or ([item["pr"]] if item.get("pr") else []):
        refs = gh("pr", "view", pr, "--json", "closingIssuesReferences")["closingIssuesReferences"]
        if refs:
            return refs[0]["url"]
    return None


def active_issues(cache: dict, by_effort: dict[str, dict]) -> tuple[set[str], set[str], list[dict], dict[str, set[str]]]:
    """Return the active issues, the ones board cards stand for, unlinked items, and parentless efforts' issues."""
    active, top, missing, parentless = set(), set(), [], {}
    for path in sorted(BACKLOG.glob("*.json")):
        item = json.loads(path.read_text())
        if item["status"] != "started":
            continue
        effort = by_effort.get(item.get("effort") or "") or {}
        if effort.get("issue"):
            active.add(effort["issue"])
            top.add(effort["issue"])
        elif not item.get("issue"):
            try:
                item["issue"] = closing_issue(item)
            except (RuntimeError, KeyError) as err:
                print(f"error {item['id']}: can't read its PR: {err}")
            if item.get("issue"):
                write_json(path, item)
        linked = parentless.setdefault(item["effort"], set()) if effort.get("board") and not effort["issue"] else set()
        if not item.get("issue"):
            if not effort.get("board"):
                missing.append(item)
            continue
        try:
            parent = content_state(item["issue"], cache).get("parent_issue_url")
        except (RuntimeError, AttributeError) as err:
            print(f"error {item['id']}: can't read its issue {item['issue']}: {err}")
            continue
        active.add(item["issue"])
        if parent:
            active.add(html_url(parent))
        if not effort.get("issue"):
            top.add(html_url(parent) if parent else item["issue"])
        linked.add(html_url(parent) if parent else item["issue"])
    return active, top, missing, parentless


def utc(stamp: str) -> datetime.datetime:
    return datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone(datetime.timezone.utc)


def outdated(effort: dict, edits: list[dict], cache: dict) -> list[str]:
    """Say how an open parent issue's checklist and effort moved on since the issue or its last proposed edit changed."""
    issue = content_state(effort["issue"], cache)
    if issue["state"] == "closed":
        return []
    since = max([utc(issue["updated_at"]), *(utc(p["at"]) for p in edits)])
    owner, repo = re.match(r"https://github\.com/([^/]+)/([^/]+)/", effort["issue"]).groups()
    closed = []
    for line in (issue.get("body") or "").splitlines():
        if not re.match(r"\s*[-*] \[ \]", line):
            continue
        for m in REFERENCE.finditer(line):
            full, short, local = m.group(1, 2, 3), m.group(4, 5, 6), (owner, repo, m.group(7))
            ref_owner, ref_repo, number = next(g for g in (full, short, local) if g[2])
            try:
                ref = content_state(f"https://github.com/{ref_owner}/{ref_repo}/issues/{number}", cache)
            except RuntimeError:
                continue
            if ref["state"] == "closed" and utc(ref["closed_at"]) > since:
                closed.append(f"{ref_owner}/{ref_repo}#{number}")
    reasons = [f"unchecked but closed or merged: {', '.join(closed)}"] if closed else []
    if effort["repos"] and (datetime.datetime.now(datetime.timezone.utc) - since).days >= OUTDATED_DAYS:
        repos = " ".join(f"repo:{r}" for r in effort["repos"])
        stamp = since.isoformat(timespec="seconds").replace("+00:00", "Z")
        q = f"{repos} is:pr is:merged merged:>{stamp} -author:app/dependabot -author:app/renovate"
        merged = gh("api", "-X", "GET", "search/issues", "-f", f"q={q}", "-f", "per_page=1")["total_count"]
        if merged:
            reasons.append(f"PRs merged in {', '.join(effort['repos'])} since {stamp[:10]}: {merged}")
    return reasons


def propose_board(board: str, me: str, active: set[str], top: set[str], cache: dict) -> tuple[list[dict], list[str]]:
    owner, number = board.split("/")
    status_field = fields(board)["status"]
    names = {o["name"].lower(): o["name"] for o in status_field["options"]}
    items = gh("project", "item-list", number, "--owner", owner, "--format", "json", "--limit", "500")["items"]
    found, on_board = [], set()
    now = datetime.datetime.now(datetime.timezone.utc)
    for item in items:
        content = item.get("content") or {}
        url, status = content.get("url"), (item.get("status") or "").lower()
        if not url or "/pull/" not in url and "/issues/" not in url:
            continue
        on_board.add(url)
        if status == "done":
            continue
        issue = content_state(url, cache)
        merged = (issue.get("pull_request") or {}).get("merged_at")
        common = {"item": item["id"], "from": item.get("status"), "issue": issue_context(issue)}
        if issue["state"] == "closed":
            why = "its PR merged" if merged else "its issue is closed"
            found.append(proposal(board, "move", url, item["title"], names["done"], why, **common))
        elif status in EARLY and url in active:
            found.append(proposal(board, "move", url, item["title"], names["in progress"], "a desk task works on it", **common))
        elif status == "in progress" and me in (item.get("assignees") or []):
            idle = (now - datetime.datetime.fromisoformat(issue["updated_at"].replace("Z", "+00:00"))).days
            if idle >= STALE_DAYS:
                found.append(
                    proposal(board, "move", url, item["title"], names["later"], f"no activity for {idle} days", **common)
                )
    candidates = sorted({u for u in top if f"github.com/{owner}/" in u} - on_board)
    return found, candidates


def propose(args: argparse.Namespace) -> None:
    me = gh("api", "user")["login"]
    cache: dict = {}
    by_effort = efforts()
    active, top, missing, parentless = active_issues(cache, by_effort)
    fresh, candidates = [], {}
    for board in boards():
        try:
            found, candidates[board] = propose_board(board, me, active, top, cache)
        except (RuntimeError, KeyError) as err:
            print(f"error {board}: {err}")
            continue
        fresh += found
    with locked(PROPOSALS):
        old = {p["id"]: p for p in json.loads(PROPOSALS.read_text())} if PROPOSALS.exists() else {}
        held = {i: p for i, p in old.items() if p["state"] != "open" or p["action"] != "move" or p.get("revised")}
        refreshed = {
            p["id"]: {**old.get(p["id"], {}), **p, "at": old.get(p["id"], p).get("at", p["at"])}
            for p in fresh
            if p["id"] not in held
        }
        chatted = [p for i, p in old.items() if i not in held and i not in refreshed and p.get("chat")]
        kept = [*held.values(), *refreshed.values(), *chatted]
        write_json(PROPOSALS, kept)
    for p in kept:
        if p["state"] in ("open", "approved", "failed"):
            print(f"{p['state']} {p['id']} {p['board']} {p['action']} {p['url']} to {p['to']}: {p['why']}")
    for board, urls in candidates.items():
        for url in urls:
            print(f"candidate {board} {url}")
    drafted = {p.get("effort") for p in kept}
    for slug, linked in sorted(parentless.items()):
        if slug not in drafted:
            print(f"noparent {slug} {by_effort[slug]['board']} {' '.join(sorted(linked))}".rstrip())
    for slug, effort in sorted(by_effort.items()):
        edits = [p for p in kept if p["action"] == "edit" and p["url"] == effort["issue"]]
        if not effort["issue"] or any(p["state"] in ("open", "approved", "failed") for p in edits):
            continue
        try:
            reasons = outdated(effort, edits, cache)
        except (RuntimeError, KeyError, ValueError) as err:
            print(f"error {slug}: can't check its issue {effort['issue']}: {err}")
            continue
        if reasons:
            print(f"outdated {slug} {effort['issue']}: {' and '.join(reasons)}")
    for item in missing:
        print(f"noissue {item['id']} {item['title']}")


def checked_fields(board: str, status: str, field: list[str] | None) -> dict[str, str]:
    if board not in boards():
        sys.exit(f"unknown board {board}, use one of: {', '.join(boards())}")
    board_fields = fields(board)
    extra = dict(f.split("=", 1) for f in field or [])
    try:
        for name, value in {"status": status, **extra}.items():
            option(board_fields[name.lower()], value)
    except (KeyError, ValueError) as err:
        sys.exit(f"not a field or option of {board}: {err}")
    return extra


def save(new: dict) -> None:
    with locked(PROPOSALS):
        old = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        if all(p["id"] != new["id"] for p in old):
            for p in old:
                if new["action"] == "edit" and p["action"] == "edit" and p["url"] == new["url"] and p["state"] == "open":
                    p["state"] = "dismissed"
            write_json(PROPOSALS, [*old, new])
    print(new["id"])


def suggest(args: argparse.Namespace) -> None:
    extra = checked_fields(args.board, args.status, args.field)
    issue = content_state(args.url, {})
    save(proposal(args.board, "add", args.url, issue["title"], args.status, args.why, fields=extra, issue=issue_context(issue)))


def draft(args: argparse.Namespace) -> None:
    if bool(args.board) != bool(args.status):
        sys.exit("--board and --status go together")
    if args.parent and not re.match(r"https://github\.com/[^/]+/[^/]+/issues/\d+$", args.parent):
        sys.exit(f"--parent must be an issue URL, not {args.parent}")
    if args.item and not (BACKLOG / f"{args.item}.json").exists():
        sys.exit(f"no backlog item {args.item}")
    if args.effort and not (EFFORTS / args.effort / "status.md").exists():
        sys.exit(f"no effort {args.effort}")
    extra = checked_fields(args.board, args.status, args.field) if args.board else {}
    body = sys.stdin.read().strip()
    found = {"repo": args.repo, "body": body, "parent": args.parent, "backlog": args.item, "effort": args.effort, "fields": extra}
    save(proposal(args.board or "", "create", None, args.title, args.status, args.why, **found))


def edit(args: argparse.Namespace) -> None:
    issue = content_state(args.url, {})
    save(proposal("", "edit", args.url, issue["title"], None, args.why, body=sys.stdin.read().strip()))


def checked(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        kept = [p for p in proposals if not (p["state"] == "checked" and p["url"] == args.url)]
        write_json(PROPOSALS, [*kept, {**proposal("", "edit", args.url, "", None, "checked"), "state": "checked"}])


def dismiss(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        for p in proposals:
            if p["id"] in args.ids and p["state"] == "open":
                p["state"] = "dismissed"
        write_json(PROPOSALS, proposals)


def revise(args: argparse.Namespace) -> None:
    body = sys.stdin.read().strip() if args.body else None
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        p = next((p for p in proposals if p["id"] == args.id and p["state"] in ("open", "failed")), None)
        if p is None:
            sys.exit(f"no open proposal {args.id}")
        if args.status or args.field:
            extra = checked_fields(p["board"], args.status or p["to"], args.field)
            p["to"] = args.status or p["to"]
            if args.field:
                p["fields"] = extra
        if args.title:
            p["title"] = args.title
        if body is not None:
            p["body"] = body
        p.update(why=args.why, state="open", revised=True)
        p.pop("error", None)
        write_json(PROPOSALS, proposals)


def chat(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        p = next((p for p in proposals if p["id"] == args.id), None)
        if p is None:
            sys.exit(f"no proposal {args.id}")
        message = {"at": datetime.datetime.now().isoformat(timespec="seconds"), "by": args.by, "text": args.text}
        p.setdefault("chat", []).append(message)
        write_json(PROPOSALS, proposals)


def set_field(project_id: str, item: str, field: dict, value: str) -> None:
    option_id = option(field, value)["id"]
    gh(
        "project",
        "item-edit",
        "--id",
        item,
        "--project-id",
        project_id,
        "--field-id",
        field["id"],
        "--single-select-option-id",
        option_id,
    )


def body_file(text: str) -> str:
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write(text + "\n")
    return f.name


def create_issue(p: dict) -> None:
    """Create the issue once, recording each step on the proposal so a retry skips what already happened."""
    if not p.get("url"):
        p["url"] = gh_text(
            "issue", "create", "--repo", p["repo"], "--title", p["title"], "--body-file", body_file(p["body"])
        ).strip()
    if p.get("parent") and not p.get("linked"):
        owner, repo, number = re.match(r"https://github\.com/([^/]+)/([^/]+)/issues/(\d+)", p["parent"]).groups()
        sub_id = content_state(p["url"], {})["id"]
        gh_text("api", "-X", "POST", f"repos/{owner}/{repo}/issues/{number}/sub_issues", "-F", f"sub_issue_id={sub_id}")
        p["linked"] = True
    if p.get("backlog"):
        path = BACKLOG / f"{p['backlog']}.json"
        item = json.loads(path.read_text())
        item["issue"] = p["url"]
        write_json(path, item)
    if p.get("effort"):
        status = EFFORTS / p["effort"] / "status.md"
        lines = [line for line in status.read_text().splitlines() if not line.startswith("Issue:")]
        at = next((i + 1 for i, line in enumerate(lines) if line.startswith("Scope:")), len(lines))
        status.write_text("\n".join([*lines[:at], f"Issue: {p['url']}", *lines[at:]]) + "\n")


def apply(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        for p in (p for p in proposals if p["state"] == "approved"):
            try:
                if p["action"] == "create":
                    create_issue(p)
                elif p["action"] == "edit":
                    gh_text("issue", "edit", p["url"], "--body-file", body_file(p["body"]))
                if p["board"] and p["to"]:
                    owner, number = p["board"].split("/")
                    project_id = gh("project", "view", number, "--owner", owner, "--format", "json")["id"]
                    board_fields = fields(p["board"])
                    item = p.get("item")
                    if p["action"] in ("add", "create"):
                        item = gh("project", "item-add", number, "--owner", owner, "--url", p["url"], "--format", "json")["id"]
                    set_field(project_id, item, board_fields["status"], p["to"])
                    for name, value in (p.get("fields") or {}).items():
                        set_field(project_id, item, board_fields[name.lower()], value)
                p["state"] = "applied"
                print(f"applied {p['id']} {p['board'] or '-'} {p['action']} {p['url']} to {p['to'] or '-'}")
            except (RuntimeError, ValueError, KeyError, OSError) as err:
                p["state"], p["error"] = "failed", str(err)
                print(f"failed {p['id']} {p['url']}: {p['error']}")
        write_json(PROPOSALS, proposals)


def main() -> None:
    require_desk_home()
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    p_propose = sub.add_parser("propose", help="refresh the proposed moves and print what needs a link or an edit")
    p_propose.set_defaults(func=propose)
    p_suggest = sub.add_parser("suggest", help="propose adding an issue or PR to a board")
    p_suggest.add_argument("--board", required=True, help="owner/number, as in watch.json")
    p_suggest.add_argument("--url", required=True)
    p_suggest.add_argument("--status", required=True)
    p_suggest.add_argument("--field", action="append", help="another single-select field as Name=Value, repeatable")
    p_suggest.add_argument("--why", required=True, help="one line")
    p_suggest.set_defaults(func=suggest)
    p_draft = sub.add_parser(
        "draft", help="propose a new issue, read its body from stdin, optionally as a sub-issue or on a board"
    )
    p_draft.add_argument("--repo", required=True, help="owner/repo, the board's backlog repo")
    p_draft.add_argument("--title", required=True)
    p_draft.add_argument("--parent", help="the parent issue URL, to file it as a sub-issue")
    p_draft.add_argument("--item", help="the backlog item to link the new issue to")
    p_draft.add_argument("--effort", help="the effort whose parent issue this is, to add it as its Issue line")
    p_draft.add_argument("--board", help="owner/number, to add it to a board")
    p_draft.add_argument("--status", help="its status on the board")
    p_draft.add_argument("--field", action="append", help="another single-select field as Name=Value, repeatable")
    p_draft.add_argument("--why", required=True, help="one line")
    p_draft.set_defaults(func=draft)
    p_edit = sub.add_parser("edit", help="propose a new body for an issue, read from stdin")
    p_edit.add_argument("--url", required=True)
    p_edit.add_argument("--why", required=True, help="one line")
    p_edit.set_defaults(func=edit)
    p_checked = sub.add_parser("checked", help="mark a parent issue as still right, so outdated counts from now")
    p_checked.add_argument("url")
    p_checked.set_defaults(func=checked)
    p_dismiss = sub.add_parser("dismiss", help="drop open proposals that my notes in watch.json rule out")
    p_dismiss.add_argument("ids", nargs="+")
    p_dismiss.set_defaults(func=dismiss)
    p_revise = sub.add_parser("revise", help="change an open proposal as my chat asks, keeping its id and chat")
    p_revise.add_argument("id")
    p_revise.add_argument("--status", help="the new status on its board")
    p_revise.add_argument("--field", action="append", help="replace its other fields, as Name=Value, repeatable")
    p_revise.add_argument("--title", help="the new title of a drafted issue")
    p_revise.add_argument("--body", action="store_true", help="read a new issue body from stdin")
    p_revise.add_argument("--why", required=True, help="one line")
    p_revise.set_defaults(func=revise)
    p_chat = sub.add_parser("chat", help="answer my chat message on a proposal")
    p_chat.add_argument("id")
    p_chat.add_argument("text")
    p_chat.add_argument("--by", required=True, choices=["desk", "manager"])
    p_chat.set_defaults(func=chat)
    sub.add_parser("apply", help="apply the proposals I approved").set_defaults(func=apply)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
