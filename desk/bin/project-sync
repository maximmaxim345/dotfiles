#!/usr/bin/env python3
"""Propose changes to the GitHub project boards and backlog issues in ~/desk/watch.json, and apply the ones I approved."""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

DESK = Path.home() / "desk"
CONFIG = DESK / "watch.json"
BACKLOG = DESK / "backlog"
PROPOSALS = DESK / "state" / "proposals.json"
EARLY = {"triage", "later", "next"}
STALE_DAYS = 14

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "board"))
from server import locked, write_json  # noqa: E402


def gh_text(*args: str) -> str:
    result = subprocess.run(["gh", *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"gh exit {result.returncode}")
    return result.stdout


def gh(*args: str) -> object:
    return json.loads(gh_text(*args) or "null")


def boards() -> list[str]:
    config = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    return [f"{b['owner']}/{b['number']}" for b in config.get("projects", [])]


def fields(board: str) -> dict[str, dict]:
    owner, number = board.split("/")
    return {f["name"].lower(): f for f in gh("project", "field-list", number, "--owner", owner, "--format", "json")["fields"]}


def option(field: dict, name: str) -> dict:
    found = next((o for o in field.get("options", []) if o["name"].lower() == name.lower()), None)
    if found is None:
        raise ValueError(f"{field['name']} has no option {name}")
    return found


def proposal(board: str, action: str, url: str | None, title: str, to: str | None, why: str, **extra: object) -> dict:
    body = f" {extra['body']}" if extra.get("body") else ""
    key = hashlib.sha1(f"{board} {action} {url or title} {to}{body}".encode()).hexdigest()[:10]
    return {
        "id": key,
        "board": board,
        "action": action,
        "url": url,
        "title": title,
        "to": to,
        "why": why,
        "state": "open",
        "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        **extra,
    }


def content_state(url: str, cache: dict) -> dict:
    if url not in cache:
        owner, repo, number = re.match(r"https://github\.com/([^/]+)/([^/]+)/(?:issues|pull)/(\d+)", url).groups()
        cache[url] = gh("api", f"repos/{owner}/{repo}/issues/{number}")
    return cache[url]


def html_url(api_url: str) -> str:
    return api_url.replace("https://api.github.com/repos/", "https://github.com/")


def active_issues(cache: dict) -> tuple[set[str], set[str], list[dict]]:
    """Return the issues started items work on with their parents, the ones a board card stands for, and items without one."""
    active, top, missing = set(), set(), []
    for path in sorted(BACKLOG.glob("*.json")):
        item = json.loads(path.read_text())
        if item["status"] != "started":
            continue
        if not item.get("issue"):
            missing.append(item)
            continue
        try:
            parent = content_state(item["issue"], cache).get("parent_issue_url")
        except (RuntimeError, AttributeError) as err:
            print(f"error {item['id']}: can't read its issue {item['issue']}: {err}")
            continue
        active.add(item["issue"])
        if parent:
            active.add(html_url(parent))
        top.add(html_url(parent) if parent else item["issue"])
    return active, top, missing


def propose_board(board: str, me: str, active: set[str], top: set[str], cache: dict) -> tuple[list[dict], list[str]]:
    owner, number = board.split("/")
    status_field = fields(board)["status"]
    names = {o["name"].lower(): o["name"] for o in status_field["options"]}
    items = gh("project", "item-list", number, "--owner", owner, "--format", "json", "--limit", "500")["items"]
    found, on_board = [], set()
    now = datetime.datetime.now(datetime.timezone.utc)
    for item in items:
        content = item.get("content") or {}
        url, status = content.get("url"), (item.get("status") or "").lower()
        if not url or "/pull/" not in url and "/issues/" not in url:
            continue
        on_board.add(url)
        if status == "done":
            continue
        issue = content_state(url, cache)
        merged = (issue.get("pull_request") or {}).get("merged_at")
        common = {"item": item["id"], "from": item.get("status")}
        if issue["state"] == "closed":
            why = "its PR merged" if merged else "its issue is closed"
            found.append(proposal(board, "move", url, item["title"], names["done"], why, **common))
        elif status in EARLY and url in active:
            found.append(proposal(board, "move", url, item["title"], names["in progress"], "a desk task works on it", **common))
        elif status == "in progress" and me in (item.get("assignees") or []):
            idle = (now - datetime.datetime.fromisoformat(issue["updated_at"].replace("Z", "+00:00"))).days
            if idle >= STALE_DAYS:
                found.append(
                    proposal(board, "move", url, item["title"], names["later"], f"no activity for {idle} days", **common)
                )
    candidates = sorted({u for u in top if f"github.com/{owner}/" in u} - on_board)
    return found, candidates


def propose(args: argparse.Namespace) -> None:
    me = gh("api", "user")["login"]
    cache: dict = {}
    active, top, missing = active_issues(cache)
    fresh, candidates = [], {}
    for board in boards():
        try:
            found, candidates[board] = propose_board(board, me, active, top, cache)
        except (RuntimeError, KeyError) as err:
            print(f"error {board}: {err}")
            continue
        fresh += found
    with locked(PROPOSALS):
        old = {p["id"]: p for p in json.loads(PROPOSALS.read_text())} if PROPOSALS.exists() else {}
        kept = [p for p in old.values() if p["state"] != "open" or p["action"] != "move"]
        kept += [
            {**p, "at": old.get(p["id"], p).get("at", p["at"])}
            for p in fresh
            if p["id"] not in old or old[p["id"]]["state"] == "open"
        ]
        write_json(PROPOSALS, kept)
    for p in kept:
        if p["state"] in ("open", "approved", "failed"):
            print(f"{p['state']} {p['id']} {p['board']} {p['action']} {p['url']} to {p['to']}: {p['why']}")
    for board, urls in candidates.items():
        for url in urls:
            print(f"candidate {board} {url}")
    for item in missing:
        print(f"noissue {item['id']} {item['title']}")


def checked_fields(board: str, status: str, field: list[str] | None) -> dict[str, str]:
    if board not in boards():
        sys.exit(f"unknown board {board}, use one of: {', '.join(boards())}")
    board_fields = fields(board)
    extra = dict(f.split("=", 1) for f in field or [])
    try:
        for name, value in {"status": status, **extra}.items():
            option(board_fields[name.lower()], value)
    except (KeyError, ValueError) as err:
        sys.exit(f"not a field or option of {board}: {err}")
    return extra


def save(new: dict) -> None:
    with locked(PROPOSALS):
        old = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        if all(p["id"] != new["id"] for p in old):
            for p in old:
                if new["action"] == "edit" and p["action"] == "edit" and p["url"] == new["url"] and p["state"] == "open":
                    p["state"] = "dismissed"
            write_json(PROPOSALS, [*old, new])
    print(new["id"])


def suggest(args: argparse.Namespace) -> None:
    extra = checked_fields(args.board, args.status, args.field)
    issue = content_state(args.url, {})
    save(proposal(args.board, "add", args.url, issue["title"], args.status, args.why, fields=extra))


def draft(args: argparse.Namespace) -> None:
    if bool(args.board) != bool(args.status):
        sys.exit("--board and --status go together")
    if args.parent and not re.match(r"https://github\.com/[^/]+/[^/]+/issues/\d+$", args.parent):
        sys.exit(f"--parent must be an issue URL, not {args.parent}")
    if args.item and not (BACKLOG / f"{args.item}.json").exists():
        sys.exit(f"no backlog item {args.item}")
    extra = checked_fields(args.board, args.status, args.field) if args.board else {}
    body = sys.stdin.read().strip()
    found = {"repo": args.repo, "body": body, "parent": args.parent, "backlog": args.item, "fields": extra}
    save(proposal(args.board or "", "create", None, args.title, args.status, args.why, **found))


def edit(args: argparse.Namespace) -> None:
    issue = content_state(args.url, {})
    save(proposal("", "edit", args.url, issue["title"], None, args.why, body=sys.stdin.read().strip()))


def dismiss(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        for p in proposals:
            if p["id"] in args.ids and p["state"] == "open":
                p["state"] = "dismissed"
        write_json(PROPOSALS, proposals)


def set_field(project_id: str, item: str, field: dict, value: str) -> None:
    option_id = option(field, value)["id"]
    gh(
        "project",
        "item-edit",
        "--id",
        item,
        "--project-id",
        project_id,
        "--field-id",
        field["id"],
        "--single-select-option-id",
        option_id,
    )


def body_file(text: str) -> str:
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write(text + "\n")
    return f.name


def create_issue(p: dict) -> None:
    """Create the issue once, recording each step on the proposal so a retry skips what already happened."""
    if not p.get("url"):
        p["url"] = gh_text(
            "issue", "create", "--repo", p["repo"], "--title", p["title"], "--body-file", body_file(p["body"])
        ).strip()
    if p.get("parent") and not p.get("linked"):
        owner, repo, number = re.match(r"https://github\.com/([^/]+)/([^/]+)/issues/(\d+)", p["parent"]).groups()
        sub_id = content_state(p["url"], {})["id"]
        gh_text("api", "-X", "POST", f"repos/{owner}/{repo}/issues/{number}/sub_issues", "-F", f"sub_issue_id={sub_id}")
        p["linked"] = True
    if p.get("backlog"):
        path = BACKLOG / f"{p['backlog']}.json"
        item = json.loads(path.read_text())
        item["issue"] = p["url"]
        write_json(path, item)


def apply(args: argparse.Namespace) -> None:
    with locked(PROPOSALS):
        proposals = json.loads(PROPOSALS.read_text()) if PROPOSALS.exists() else []
        for p in (p for p in proposals if p["state"] == "approved"):
            try:
                if p["action"] == "create":
                    create_issue(p)
                elif p["action"] == "edit":
                    gh_text("issue", "edit", p["url"], "--body-file", body_file(p["body"]))
                if p["board"] and p["to"]:
                    owner, number = p["board"].split("/")
                    project_id = gh("project", "view", number, "--owner", owner, "--format", "json")["id"]
                    board_fields = fields(p["board"])
                    item = p.get("item")
                    if p["action"] in ("add", "create"):
                        item = gh("project", "item-add", number, "--owner", owner, "--url", p["url"], "--format", "json")["id"]
                    set_field(project_id, item, board_fields["status"], p["to"])
                    for name, value in (p.get("fields") or {}).items():
                        set_field(project_id, item, board_fields[name.lower()], value)
                p["state"] = "applied"
                print(f"applied {p['id']} {p['board'] or '-'} {p['action']} {p['url']} to {p['to'] or '-'}")
            except (RuntimeError, ValueError, KeyError, OSError) as err:
                p["state"], p["error"] = "failed", str(err)
                print(f"failed {p['id']} {p['url']}: {p['error']}")
        write_json(PROPOSALS, proposals)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("propose", help="refresh the proposed moves and print them with candidates to add").set_defaults(func=propose)
    p_suggest = sub.add_parser("suggest", help="propose adding an issue or PR to a board")
    p_suggest.add_argument("--board", required=True, help="owner/number, as in watch.json")
    p_suggest.add_argument("--url", required=True)
    p_suggest.add_argument("--status", required=True)
    p_suggest.add_argument("--field", action="append", help="another single-select field as Name=Value, repeatable")
    p_suggest.add_argument("--why", required=True, help="one line")
    p_suggest.set_defaults(func=suggest)
    p_draft = sub.add_parser(
        "draft", help="propose a new issue, read its body from stdin, optionally as a sub-issue or on a board"
    )
    p_draft.add_argument("--repo", required=True, help="owner/repo, the board's backlog repo")
    p_draft.add_argument("--title", required=True)
    p_draft.add_argument("--parent", help="the parent issue URL, to file it as a sub-issue")
    p_draft.add_argument("--item", help="the backlog item to link the new issue to")
    p_draft.add_argument("--board", help="owner/number, to add it to a board")
    p_draft.add_argument("--status", help="its status on the board")
    p_draft.add_argument("--field", action="append", help="another single-select field as Name=Value, repeatable")
    p_draft.add_argument("--why", required=True, help="one line")
    p_draft.set_defaults(func=draft)
    p_edit = sub.add_parser("edit", help="propose a new body for an issue, read from stdin")
    p_edit.add_argument("--url", required=True)
    p_edit.add_argument("--why", required=True, help="one line")
    p_edit.set_defaults(func=edit)
    p_dismiss = sub.add_parser("dismiss", help="drop open proposals that my notes in watch.json rule out")
    p_dismiss.add_argument("ids", nargs="+")
    p_dismiss.set_defaults(func=dismiss)
    sub.add_parser("apply", help="apply the proposals I approved").set_defaults(func=apply)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
