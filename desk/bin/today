#!/usr/bin/env python3
"""Print my Today list within my minutes budget, with the items whose minutes are a guess because they have no size."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "board"))
from server import INCOMING, THREADS, WORKTREES, all_items, incoming_shown, plan_day  # noqa: E402


def main() -> None:
    items = all_items()
    threads = json.loads(THREADS.read_text()) if THREADS.exists() else {}
    incoming = [e for e in (json.loads(INCOMING.read_text()) if INCOMING.exists() else {}).values() if incoming_shown(e)]
    worktrees = json.loads(WORKTREES.read_text()) if WORKTREES.exists() else {}
    day = plan_day(items, threads, incoming, None, worktrees)
    above = [row for row in day["rows"] if row["today"]]
    planned = day["waiting"] + sum(row["minutes"] for row in above)
    print(
        f"Today: {len(above)} items and {day['waiting']} min that wait on me, {planned} of {day['budget']} min,"
        f" {len(day['rows']) - len(above)} later"
    )
    for row in above:
        guess = "" if items[row["id"]].get("size") else ", a guess"
        print(f"  {row['minutes']:>3} min{guess}  {row['id']}  {items[row['id']]['title']}")


if __name__ == "__main__":
    main()
